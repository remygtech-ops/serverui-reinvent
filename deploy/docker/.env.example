# Copy this file to the repository root as .env (when running from a clone),
# or keep a local copy here (deploy/docker/.env — Compose also accepts it).
#   cp deploy/docker/.env.example .env
#   make setup-env
#
# Never commit a real .env file.

# --- Runtime / ports ---
# Interface the published ports bind to. 127.0.0.1 keeps ServerUI reachable only from this
# machine. ServerUI has no login of its own: put it behind an authenticating reverse proxy
# before setting this to 0.0.0.0 or a LAN address.
BIND_HOST=127.0.0.1
# Extra browser origins allowed to call the API, e.g. https://serverui.example.com
SERVERUI_ALLOWED_ORIGINS=
# Host names you reach ServerUI by, besides localhost (comma-separated), e.g. 192.168.1.5 or
# serverui.example.com. Requests for any other name are refused (DNS rebinding protection).
SERVERUI_ALLOWED_HOSTS=
HTTP_PORT=8080
WEB_PORT=3000

# --- Database ---
POSTGRES_USER=serverui
POSTGRES_PASSWORD=example_password
POSTGRES_DB=serverui
# Compose sets POSTGRES_HOST=postgres in docker-compose.yml; only set these
# explicitly when pointing at an external database.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Optional DSN. POSTGRES_* above is enough in Compose.
DATABASE_URL=postgresql://serverui:example_password@postgres:5432/serverui?sslmode=disable

# --- Credentials (backend only; never expose to the browser) ---
# 32-byte AES-256-GCM key as 64 hex characters.
# Generate with: openssl rand -hex 32  (or run: make setup-env)
SERVERUI_CREDENTIAL_ENCRYPTION_KEY=

# --- Browser API (optional) ---
# Absolute origin for the Go API when the UI should not use same-origin rewrites.
# NEXT_PUBLIC_API_BASE=

# --- Deployment / Next.js rewrites (server-side only; not a browser secret) ---
# Used inside the web container to reach the Go service by Docker DNS name.
# Compose sets this to http://server:8080.
# SERVER_INTERNAL_URL=http://server:8080
